# Copia este archivo como ".env" y completa los valores. El archivo ".env" NO se comparte ni se sube a git.

# "mock" = banco simulado (no necesita credenciales). "real" = API del banco.
BANK_MODE=mock

# --- Solo para BANK_MODE=real ---
# Certificación: https://apimktdesa.baneco.com.bo/ApiGateway  (producción: la URL que entregue el banco)
BANK_BASE_URL=https://apimktdesa.baneco.com.bo/ApiGateway
BANK_USERNAME=
# Llave AES entregada por el banco: exactamente 32 caracteres (256 bits)
BANK_AES_KEY=
# Elige UNA de las dos formas de dar la contraseña de la API:
BANK_PASSWORD_PLAIN=
BANK_PASSWORD_ENCRYPTED=
# Cuenta que recibe los cobros (se cifra con AES antes de enviarla)
BANK_ACCOUNT_CREDIT=
# Token que el banco enviará al avisar un pago (cabecera Authorization: Bearer <token>)
BANK_NOTIFY_TOKEN=

# --- Aplicación ---
PORT=3000
# Precios de los dos productos de la demo, en Bs (usa 0.01 para probar con un centavo)
DEMO_PRICE_1=0.01
DEMO_PRICE_2=0.01
