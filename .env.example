# Frontend (público, seguro de exponer)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo servidor: configurar como secretos de Supabase Edge Functions
# (supabase secrets set NOMBRE=valor). NUNCA en el frontend, en git ni en el chat.
# Certificación: https://apimktdesa.baneco.com.bo/ApiGateway  (producción: la que entregue el banco)
BANCO_ECONOMICO_BASE_URL=
BANCO_ECONOMICO_USERNAME=
BANCO_ECONOMICO_PASSWORD=
# Si el usuario de certificación NO tiene contraseña: vacio | usuario (ver docs/integraciones/banco-economico.md). Dejar vacío si hay PASSWORD.
BANCO_ECONOMICO_PASSWORD_FROM=
# Llave AES-256 entregada por el banco (certificación y producción son distintas)
BANCO_ECONOMICO_AES_KEY=
# Cuenta que recibe los cobros (se cifra con AES antes de enviarla como accountCredit)
BANCO_ECONOMICO_ACCOUNT_CREDIT=
# Token secreto en la ruta del aviso notifyPaymentQR
BANCO_ECONOMICO_NOTIFY_TOKEN=
# Secreto de las tareas programadas (check-payments y expire-orders, cabecera x-cron-secret). Generar uno largo y aleatorio.
CRON_SECRET=
# Orígenes de la PWA permitidos, separados por comas (ej. https://garagesales.bo)
ALLOWED_ORIGINS=
SUPABASE_SERVICE_ROLE_KEY=
