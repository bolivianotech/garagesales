{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "typeRoots": [
      "/opt/node-tools/node_modules/@types"
    ],
    "paths": {
      "npm:@supabase/supabase-js@2": [
        "../../apps/pwa/node_modules/@supabase/supabase-js"
      ]
    }
  },
  "include": [
    "_shared/*.ts",
    "*/index.ts",
    "types/*.d.ts",
    "_tests/*.ts"
  ]
}